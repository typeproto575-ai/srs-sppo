# Belt-and-suspenders: even though this directory should never be requested
# directly (files are served only through includes/view-upload.php after a
# role check), block direct access at the web-server level too.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
