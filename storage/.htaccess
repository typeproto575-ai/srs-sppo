# Belt-and-suspenders: this directory holds no web-served content — the
# online ID-upload feature was removed from the design (identity is verified
# in person at pickup). Block direct access at the web-server level, and
# storage/index.php returns 403 as a second guard in case .htaccess is ignored.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 fallback
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
